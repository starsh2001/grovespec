# GroveSpec format schema — the single source of truth for artifact formats.
# Both bin/grovespec (the checker) and FORMATS.md (human prose) defer to THIS file.
# Kept flat with |-separated lists so bash/awk parse it with no yq/jq dependency.

task.fm.required: id|name|role|status|blocked_by|tdd
task.fm.enum.role: skeleton|feature
task.fm.enum.status: draft|approved|implemented|reviewed|fixed|done
task.sections: Overview|Requirements|Contract|AC|Subtasks|Change Log
brief.fm.required: name
brief.sections: Direction|Scope|Risks
conventions.sections: Glossary|Common Rules
lifecycle: draft|approved|implemented|reviewed|fixed|done
