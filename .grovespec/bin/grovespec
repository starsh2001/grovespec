#!/usr/bin/env bash
# grovespec — deterministic checks for a GroveSpec project.
#   validate   format + graph coherence (exit non-zero on any problem)
#   status     each node's status + which are unblocked, + next
#   impact ID  who a contract change on ID reaches (the consumer set / blast radius)
#   tree       the id-only tree.md rendered with names + status
#
# No runtime beyond bash + POSIX tools (grep/awk/sed/sort). Ships inside .grovespec/ — no install.
# Format SoT: .grovespec/schema   Paths: .grovespec/config.yaml

set -u

SCRIPT_DIR=$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd)

# ---- find project ROOT: walk up from CWD for a .grovespec/ dir; fallback to the script's repo ----
find_root() {
  local d="$PWD"
  while [ "$d" != "/" ] && [ -n "$d" ]; do
    [ -d "$d/.grovespec" ] && { echo "$d"; return; }
    d=$(dirname "$d")
  done
  ( cd "$SCRIPT_DIR/../.." >/dev/null 2>&1 && pwd )
}
ROOT=$(find_root)
CONFIG="$ROOT/.grovespec/config.yaml"
SCHEMA="$ROOT/.grovespec/schema"
[ -f "$SCHEMA" ] || SCHEMA="$SCRIPT_DIR/../schema"   # fallback: schema beside the script

# ---- config: read a flat paths: entry, resolve relative to ROOT ----
cfg() { # $1=key $2=default
  local v
  v=$(grep -E "^[[:space:]]+$1:[[:space:]]" "$CONFIG" 2>/dev/null | head -1 \
      | sed -E "s/^[[:space:]]+$1:[[:space:]]*//; s/[[:space:]]*#.*$//; s/[[:space:]]*$//")
  [ -z "$v" ] && v="$2"
  case "$v" in /*) echo "$v" ;; *) echo "$ROOT/$v" ;; esac
}
TASKS=$(cfg tasks "docs/tasks/")
TREE=$(cfg tree  "docs/tree.md")
BRIEF=$(cfg brief "docs/brief.md")
CONV=$(cfg conventions "docs/conventions.md")
SRC=$(cfg src "src/")
TASKS=${TASKS%/}; SRC=${SRC%/}   # drop trailing slash for clean paths

# ---- schema reader ----
sch()   { grep -E "^$1:" "$SCHEMA" 2>/dev/null | head -1 | sed -E "s/^$1:[[:space:]]*//"; }
pipes() { echo "$1" | tr '|' '\n'; }

# ---- artifact helpers ----
fm() { # $1=file $2=key  -> value (within leading --- frontmatter ---)
  awk -v k="$2" '
    NR==1 && /^---[[:space:]]*$/ { infm=1; next }
    infm && /^---[[:space:]]*$/ { exit }
    infm && $0 ~ "^"k"[[:space:]]*:" { sub("^"k"[[:space:]]*:[[:space:]]*",""); sub(/[[:space:]]*$/,""); sub(/^"/,""); sub(/"$/,""); print; exit }
  ' "$1" 2>/dev/null
}
sections_of() { awk '/^##[[:space:]]/{ s=$0; sub(/^##[[:space:]]+/,"",s); sub(/[[:space:]]*$/,"",s); print s }' "$1" 2>/dev/null; }
blocked_ids() { echo "$(fm "$1" blocked_by)" | tr -d '[] ' | tr ',' '\n' | grep -E '^TASK-[0-9]+$' 2>/dev/null || true; }
task_files()  { ls "$TASKS"/TASK-*.md 2>/dev/null || true; }
tid_of()      { basename "$1" .md; }
status_of()   { [ -f "$TASKS/$1.md" ] && fm "$TASKS/$1.md" status; }
name_of()     { [ -f "$TASKS/$1.md" ] && fm "$TASKS/$1.md" name; }
role_of()     { [ -f "$TASKS/$1.md" ] && fm "$TASKS/$1.md" role; }

# ---- tree.md -> rows "tid<TAB>parent<TAB>depth" (parent="" for root) ----
tree_rows() {
  awk '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*-[[:space:]]*TASK-[0-9]+[[:space:]]*$/ {
      s=$0; match(s,/^ */); depth=int(RLENGTH/2)
      t=s; sub(/^[[:space:]]*-[[:space:]]*/,"",t); sub(/[[:space:]]*$/,"",t)
      par=(depth>0)?stack[depth-1]:""
      stack[depth]=t
      print t"\t"par"\t"depth
    }
  ' "$TREE" 2>/dev/null
}
tree_ids()       { tree_rows | cut -f1; }
parent_of()      { tree_rows | awk -F'\t' -v n="$1" '$1==n{print $2; exit}'; }
children_of()    { tree_rows | awk -F'\t' -v n="$1" '$2==n{print $1}'; }

# ===================== validate =====================
PROBLEMS=0
prob() { printf '  %s\n' "$*"; PROBLEMS=$((PROBLEMS+1)); }

cmd_validate() {
  local f tid v want got b

  # --- per task file ---
  for f in $(task_files); do
    tid=$(tid_of "$f")
    for k in $(pipes "$(sch task.fm.required)"); do
      [ -n "$(fm "$f" "$k")" ] || prob "$f  frontmatter '$k' missing"
    done
    [ "$(fm "$f" id)" = "$tid" ] || prob "$f  id '$(fm "$f" id)' != filename '$tid' → set id to $tid"
    v=$(fm "$f" role)
    pipes "$(sch task.fm.enum.role)" | grep -qx "$v" || prob "$f  role '$v' invalid → use $(sch task.fm.enum.role)"
    v=$(fm "$f" status)
    pipes "$(sch task.fm.enum.status)" | grep -qx "$v" || prob "$f  status '$v' invalid → use $(sch task.fm.enum.status)"
    v=$(fm "$f" tdd)
    case "$v" in
      true) ;;
      false) [ -n "$(fm "$f" tdd_skip_reason)" ] || prob "$f  tdd:false requires tdd_skip_reason" ;;
      *) prob "$f  tdd '$v' must be true|false" ;;
    esac
    want=$(pipes "$(sch task.sections)"); got=$(sections_of "$f")
    [ "$want" = "$got" ] || prob "$f  sections mismatch → need (in order): $(sch task.sections)"
    for b in $(blocked_ids "$f"); do
      [ "$b" = "$tid" ] && prob "$f  blocked_by includes itself ($b)"
      [ -f "$TASKS/$b.md" ] || prob "$f  blocked_by '$b' has no task file"
    done
  done

  # --- tree.md line format ---
  awk '
    /^[[:space:]]*$/ { next } /^[[:space:]]*#/ { next } /^<!--/ { next }
    !/^[[:space:]]*-[[:space:]]*TASK-[0-9]+[[:space:]]*$/ { print NR": "$0 }
  ' "$TREE" 2>/dev/null | while IFS= read -r bad; do prob "$TREE:$bad  not a '- TASK-N' line"; done
  # NOTE: the while-subshell can't bump PROBLEMS; recount below instead.

  # --- tree <-> files (orphans both ways) ---
  for t in $(tree_ids); do
    [ -f "$TASKS/$t.md" ] || prob "$TREE  '$t' has no task file ($TASKS/$t.md)"
  done
  for f in $(task_files); do
    tid=$(tid_of "$f")
    tree_ids | grep -qx "$tid" || prob "$f  not in tree.md (orphan task)"
  done

  # --- impossible states ---
  for t in $(tree_ids); do
    if [ "$(status_of "$t")" = "done" ]; then
      p=$(parent_of "$t")
      [ -n "$p" ] && [ "$(status_of "$p")" != "done" ] && prob "$t is done but parent $p is $(status_of "$p")"
      for b in $(blocked_ids "$TASKS/$t.md"); do
        [ "$(status_of "$b")" != "done" ] && prob "$t is done but blocked_by $b is $(status_of "$b")"
      done
      if [ "$(role_of "$t")" = "skeleton" ] && [ -z "$(children_of "$t")" ]; then
        prob "$t is a done skeleton with no children in tree.md"
      fi
    fi
  done

  # --- blocked_by cycle (Kahn): resolve nodes whose deps are all resolved; leftovers = cycle ---
  local ids resolved progress left
  ids=$(tree_ids); resolved=" "
  while :; do
    progress=0
    for t in $ids; do
      case "$resolved" in *" $t "*) continue ;; esac
      ok=1
      for b in $(blocked_ids "$TASKS/$t.md"); do
        case "$resolved" in *" $b "*) ;; *) ok=0 ;; esac
      done
      [ "$ok" = 1 ] && { resolved="$resolved$t "; progress=1; }
    done
    [ "$progress" = 0 ] && break
  done
  for t in $ids; do
    case "$resolved" in *" $t "*) ;; *) prob "$t is in a blocked_by cycle (unresolvable)";; esac
  done

  # --- brief / conventions ---
  if [ -f "$BRIEF" ]; then
    for k in $(pipes "$(sch brief.fm.required)"); do
      [ -n "$(fm "$BRIEF" "$k")" ] || prob "$BRIEF  frontmatter '$k' missing"
    done
    want=$(pipes "$(sch brief.sections)"); got=$(sections_of "$BRIEF")
    [ "$want" = "$got" ] || prob "$BRIEF  sections → need: $(sch brief.sections)"
  else prob "$BRIEF  missing"; fi
  if [ -f "$CONV" ]; then
    want=$(pipes "$(sch conventions.sections)"); got=$(sections_of "$CONV")
    [ "$want" = "$got" ] || prob "$CONV  sections → need: $(sch conventions.sections)"
  fi

  # recount tree-line problems missed by the subshell
  local badlines
  badlines=$(awk '
    /^[[:space:]]*$/{next} /^[[:space:]]*#/{next} /^<!--/{next}
    !/^[[:space:]]*-[[:space:]]*TASK-[0-9]+[[:space:]]*$/{c++} END{print c+0}
  ' "$TREE" 2>/dev/null)
  PROBLEMS=$((PROBLEMS+badlines))

  if [ "$PROBLEMS" -eq 0 ]; then echo "✓ validate: all checks passed"; return 0
  else echo "✗ validate: $PROBLEMS problem(s)"; return 1; fi
}

# ===================== status =====================
unblocked() { # $1=tid -> "yes"/"no:reason"
  local p b
  p=$(parent_of "$1")
  [ -n "$p" ] && [ "$(status_of "$p")" != "done" ] && { echo "no:parent $p not done"; return; }
  for b in $(blocked_ids "$TASKS/$1.md"); do
    [ "$(status_of "$b")" != "done" ] && { echo "no:blocked by $b"; return; }
  done
  echo "yes"
}
cmd_status() {
  local t st ub nexts=""
  for t in $(tree_ids); do
    st=$(status_of "$t"); ub=$(unblocked "$t")
    if [ "$st" = "done" ]; then printf '%-8s done\n' "$t"
    elif [ "$ub" = "yes" ]; then printf '%-8s %-12s (unblocked)\n' "$t" "$st"; nexts="$nexts $t"
    else printf '%-8s %-12s (%s)\n' "$t" "$st" "${ub#no:}"
    fi
  done
  [ -n "$nexts" ] && echo "next:$nexts"
}

# ===================== check (the top-down gate) =====================
# check TASK-N -> is this node ready to work? (exit 0 yes / 1 no). check (no arg) -> list ready nodes.
cmd_check() {
  local n="${1:-}" t ub any=""
  if [ -z "$n" ]; then
    echo "ready to work now (top-down):"
    for t in $(tree_ids); do
      [ "$(status_of "$t")" = "done" ] && continue
      if [ "$(unblocked "$t")" = "yes" ]; then printf '  %-8s %s\n' "$t" "$(status_of "$t")"; any=1; fi
    done
    [ -z "$any" ] && echo "  (none — every non-done node is blocked)"
    return 0
  fi
  [ -f "$TASKS/$n.md" ] || { echo "✗ $n: no task file"; return 2; }
  ub=$(unblocked "$n")
  if [ "$ub" = "yes" ]; then
    echo "✓ $n is ready ($(status_of "$n")) — parent done, blocked_by done."; return 0
  fi
  echo "✗ $n is NOT ready — ${ub#no:}. Do NOT work it (that's bottom-up). Work a node 'grovespec check' lists as ready."
  return 1
}

# ===================== lang (reply/artifact language) =====================
cmd_lang() {
  local v
  v=$(grep -E '^[[:space:]]*language:' "$CONFIG" 2>/dev/null | head -1 \
      | sed -E 's/^[[:space:]]*language:[[:space:]]*//; s/[[:space:]]*#.*$//; s/[[:space:]]*$//')
  if [ -n "$v" ]; then echo "$v"; else echo "(no config.language yet — run grovespec-init)"; fi
}

# ===================== impact =====================
cmd_impact() {
  local n="${1:-}"
  [ -z "$n" ] && { echo "usage: grovespec impact TASK-N"; return 2; }
  [ -f "$TASKS/$n.md" ] || { echo "no such node: $n"; return 2; }
  echo "impact of a contract change on $n ($(name_of "$n")):"
  echo "  -- exact (depend on it) --"
  # children (depend on the parent's contract)
  for c in $(children_of "$n"); do echo "  child     $c  $(name_of "$c")"; done
  # reverse blocked_by
  for f in $(task_files); do
    tid=$(tid_of "$f")
    for b in $(blocked_ids "$f"); do
      [ "$b" = "$n" ] && echo "  consumer  $tid  $(name_of "$tid")"
    done
  done
  echo "  -- hint (name appears in code/specs — verify) --"
  grep -rln -- "$(name_of "$n")" "$SRC" "$TASKS" 2>/dev/null \
    | grep -v "/$n\.md$" | sed 's/^/  /' || true
}

# ===================== tree =====================
cmd_tree() {
  tree_rows | while IFS=$'\t' read -r t par depth; do
    pad=$(printf '%*s' $((depth*2)) "")
    printf '%s- %s  %s [%s, %s]\n' "$pad" "$t" "$(name_of "$t")" "$(role_of "$t")" "$(status_of "$t")"
  done
}

# ===================== dispatch =====================
case "${1:-}" in
  validate) cmd_validate ;;
  status)   cmd_status ;;
  check)    shift; cmd_check "${1:-}" ;;
  lang)     cmd_lang ;;
  impact)   shift; cmd_impact "${1:-}" ;;
  tree)     cmd_tree ;;
  *) echo "grovespec — validate | status | check [TASK-N] | lang | impact TASK-N | tree"; exit 2 ;;
esac
